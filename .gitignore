# ==========================================
# 1. FRONT-END (React / Node / JavaScript)
# ==========================================
**/node_modules/
**/.pnp
**/.pnp.js

# React Production Builds
**/build/
**/dist/

# React Environment Variables (contains private API keys/secrets)
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Package Manager Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*


# ==========================================
# 2. BACK-END (Spring Boot / Java / Maven)
# ==========================================
# Compiled Maven / Gradle Output
**/target/
**/bin/
**/build/
**/.gradle/

# Package Files (JAR / WAR)
**/*.jar
**/*.war
**/*.ear
**/*.zip
**/*.tar.gz


# ==========================================
# 3. IDEs & EDITORS (STS / Eclipse / VS Code)
# ==========================================
# Spring Tool Suite (STS) & Eclipse files
**/.metadata/
**/.settings/
**/.classpath
**/.project
**/.factorypath
**/*.tmp
**/*.bak

# VS Code settings
**/.vscode/
!**/.vscode/settings.json

# IntelliJ IDEA (in case someone opens it in IDEA)
**/.idea/
**/*.iml


# ==========================================
# 4. OS & SYSTEM LOGS
# ==========================================
**/*.log
.DS_Store
Thumbs.db